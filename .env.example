# Copy to .env and adjust. Every variable is optional; the defaults give a working local server.
# (Docker Compose reads .env automatically. For `npm start`, export the variables or use `node --env-file=.env server/index.js`.)

# --- Network ---------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
# Public address of the site. Use https:// in production: it turns on Secure cookies and HSTS.
BASE_URL=http://localhost:3000
# Set to true only when Wavely runs behind a reverse proxy you control (nginx, Caddy, Traefik),
# so that client IP addresses are taken from X-Forwarded-For for rate limiting.
TRUST_PROXY=false

# --- Storage ---------------------------------------------------------------
# SQLite database, audio and covers live here. Back this directory up.
DATA_DIR=./data

# --- Instance ----------------------------------------------------------------
INSTANCE_NAME=Wavely
# open   = anyone can register
# invite = registration needs INVITE_CODE
# closed = no new accounts (the very first account on an empty server is always allowed)
REGISTRATION=open
INVITE_CODE=
# users  = every account can upload
# admins = only administrators can upload
UPLOAD_POLICY=users
# true = uploads by regular users wait for a moderator's approval
REQUIRE_APPROVAL=false

# --- Limits ------------------------------------------------------------------
MAX_UPLOAD_MB=100
MAX_TRACK_MINUTES=20
SESSION_DAYS=30
# Parallel ffmpeg jobs. Raise on machines with many cores.
TRANSCODE_CONCURRENCY=2
RATE_LIMIT=true

# --- Advanced ----------------------------------------------------------------
# COOKIE_SECURE defaults to true when BASE_URL starts with https://
# COOKIE_SECURE=true
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
LOG_LEVEL=info
